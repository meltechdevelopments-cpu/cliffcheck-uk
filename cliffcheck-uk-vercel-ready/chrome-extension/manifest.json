{
  "manifest_version": 3,
  "name": "CliffCheck — Used Car Repair & Wet-Belt Alert",
  "version": "1.0.0",
  "description": "Spots hidden £1,500 wet-belt, timing-chain, DSG gearbox & £620 road-tax bills on UK used car listings + writes your haggling script.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.autotrader.co.uk/*",
    "*://*.ebay.co.uk/*",
    "*://*.cargurus.co.uk/*",
    "https://api.polar.sh/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CliffCheck UK"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.autotrader.co.uk/car-details/*",
        "*://*.ebay.co.uk/itm/*",
        "*://*.cargurus.co.uk/Cars/*"
      ],
      "js": ["config.js", "cliff-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
